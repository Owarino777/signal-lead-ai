{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signal-lead-api",
  "main": "src/saas-worker.js",
  "compatibility_date": "2026-07-23",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://owarino777.github.io",
    "SAAS_MODE": "true",
    "APP_URL": "https://owarino777.github.io/signal-lead-ai",
    "STRIPE_PRICE_SOLO": "price_REPLACE_ME",
    "STRIPE_PRICE_PRO": "price_REPLACE_ME"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "signal-lead-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
